# Copy this file to .env (or export these directly) before running server.py.

# Your workspace URL, e.g. https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
DATABRICKS_HOST=

# A personal access token: Databricks workspace -> Settings -> Developer -> Access tokens -> Generate new token.
# Needs permission to run jobs you intend to allow trigger_job_run to re-run (see
# DATABRICKS_TRIGGER_ALLOWLIST below) -- everything else this server does is read-only.
DATABRICKS_TOKEN=

# Optional. Only needed for get_table_lineage, which queries the system.access.table_lineage
# Unity Catalog system table through a SQL warehouse. Leave blank to skip table lineage (the
# tool will report itself unavailable rather than failing the whole trace).
DATABRICKS_SQL_WAREHOUSE_ID=

# Optional. How many other jobs get_job_orchestration will inspect when looking for jobs that
# trigger this one (there's no reverse index for this in the Jobs API, so it's a bounded scan).
# Default 200.
DATABRICKS_ORCHESTRATION_SCAN_LIMIT=200

# Comma-separated job IDs that trigger_job_run is allowed to auto-re-run without asking a
# human first (e.g. sandbox/staging jobs). Set to "all" ONLY in a non-production workspace.
# Anything not listed here requires the caller to pass force="true" after explicit human
# approval. Leave blank to require approval for every job.
DATABRICKS_TRIGGER_ALLOWLIST=

# Optional. Max seconds trigger_job_run waits for a re-run to finish before giving up. Default 600.
DATABRICKS_TRIGGER_TIMEOUT_SECONDS=600

# Optional. Seconds between polls while trigger_job_run waits for a run to finish. Default 10.
DATABRICKS_TRIGGER_POLL_INTERVAL_SECONDS=10
